# ─────────────────────────────────────────────────────────────
# SAGE Euphoria 2026 — Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────

# (Optional) Base URL for backend API when deployed on a different domain.
# If frontend and backend are served on the same domain (e.g. via Nginx reverse proxy),
# leave this empty or unset to automatically use same-origin relative URLs (/api).
# Example for split domain: VITE_API_URL="https://YOUR-BACKEND-DOMAIN"
VITE_API_URL=
