# ─────────────────────────────────────────────────────────────
# SAGE Euphoria 2026 — Backend Environment Configuration Template
# ─────────────────────────────────────────────────────────────

# Server Port
# In production, set to the designated port assigned by the shared server administrator (default: 5000)
PORT="5000"

# Application Environment ("development" | "production")
# MUST be set to "production" on the college production server
NODE_ENV="development"

# Database Connection Configuration (PostgreSQL / Supabase)
# DATABASE_URL (Transaction Pooler - port 6543, pgbouncer=true):
#   Used by Prisma Client for application runtime queries.
#   LOCAL:       "postgresql://username:password@localhost:5432/euphoria_db?schema=public"
#   PRODUCTION:  "postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://username:password@localhost:5432/euphoria_db?schema=public"

# DIRECT_URL (Session / Direct Connection - port 5432):
#   Used by Prisma CLI for migrations ('npx prisma migrate deploy') and schema operations.
#   Bypasses PgBouncer transaction pooler to allow direct session-level DDL commands.
#   LOCAL:       (optional in local dev; falls back to DATABASE_URL if omitted)
#   PRODUCTION:  "postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://username:password@localhost:5432/euphoria_db?schema=public"

# Admin Initial Seed Credentials (DEVELOPMENT / TEST ONLY)
# Used ONLY when running 'npm run seed' on a fresh local development/test database.
# ⚠️ WARNING: DO NOT run 'npm run seed' in production!
# In production, schema is applied via 'npx prisma migrate deploy'
# and administrative accounts / pricing must be managed through controlled operations.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Euphoria Administrator"
ADMIN_PASSWORD="your-strong-admin-password-min-12-chars"

# JWT Authentication Configuration
# MUST be a cryptographically random secret of at least 32 characters in production
JWT_SECRET="your-strong-cryptographic-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Debug OTP (Security rule: only active when NODE_ENV="development" AND EXPOSE_DEBUG_OTP="true")
# MUST be set to "false" in production to ensure OTPs are never returned in API payloads
EXPOSE_DEBUG_OTP="false"

# Filter Test Events (Set to "false" in production so test events are excluded from participant view)
ENABLE_TEST_EVENT="false"

# ─────────────────────────────────────────────────────────────
# Email & OTP Delivery Configuration (Official College SMTP)
# ─────────────────────────────────────────────────────────────
# "smtp" for real email dispatch, or "console" for mock terminal logging in dev
EMAIL_PROVIDER="smtp"

# Standard SMTP Server Host (for Gmail: smtp.gmail.com, or college mail relay)
SMTP_HOST="smtp.gmail.com"

# SMTP Server Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT="465"

# Set to "true" for port 465 (SSL), or "false" for port 587 (STARTTLS)
SMTP_SECURE="true"

# Official College Email address (e.g. euphoria@sageuniversity.in)
SMTP_USER=""

# SMTP Password or Google App Password (16 characters from Google Account Security)
SMTP_PASS=""

# Sender Address displayed to participants (e.g. "\"SAGE Euphoria 2026\" <euphoria@sageuniversity.in>")
SMTP_FROM=""

# ─────────────────────────────────────────────────────────────
# Payment Gateway Configuration (Easebuzz Sandbox / Production)
# ─────────────────────────────────────────────────────────────
# Options: "simulation" (dev mock) | "easebuzz" (live Easebuzz gateway)
PAYMENT_GATEWAY="simulation"

# Easebuzz Environment: "test" for sandbox, "prod" for production
EASEBUZZ_ENV="test"

# Easebuzz Merchant Credentials (provided by Easebuzz merchant portal)
EASEBUZZ_KEY=""
EASEBUZZ_SALT=""

# Base Application URLs for Browser Redirects & Callbacks
# LOCAL:
#   APP_FRONTEND_URL="http://localhost:5173"
#   APP_BACKEND_URL="http://localhost:5000"
# PRODUCTION:
#   APP_FRONTEND_URL="https://YOUR-FRONTEND-DOMAIN"
#   APP_BACKEND_URL="https://YOUR-BACKEND-DOMAIN"
APP_FRONTEND_URL="http://localhost:5173"
APP_BACKEND_URL="http://localhost:5000"

# CORS Origin (comma-separated list of allowed origins)
# LOCAL:       "http://localhost:5173,http://localhost:3000"
# PRODUCTION:  "https://YOUR-FRONTEND-DOMAIN"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
